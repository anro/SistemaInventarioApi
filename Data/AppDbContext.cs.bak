using Microsoft.EntityFrameworkCore;
using ApiInventario.Models;

namespace ApiInventario.Data;

public class AppDbContext : DbContext
{
    public AppDbContext(DbContextOptions<AppDbContext> options) : base(options) { }

    public DbSet<Producto> Productos { get; set; }
	
    public DbSet<Cliente> Clientes { get; set; }

	public DbSet<Proveedor> Proveedores { get; set; }
	
	public DbSet<Compra> Compras { get; set; }

	public DbSet<CompraDetalle> CompraDetalle { get; set; }
	
	public DbSet<MovimientoStock> MovimientosStock { get; set; }
	
	public DbSet<Venta> Ventas { get; set; }

	public DbSet<VentaDetalle> VentaDetalle { get; set; }
	
	public DbSet<Usuario> Usuarios { get; set; }
	
	public DbSet<Rol> Roles {get;set;}

	public DbSet<Permiso> Permisos {get;set;}

	public DbSet<RolPermiso> RolPermisos {get;set;}
		
	//<<<Configura Que Entidad Frameword reconozca Relacion entretablas, restricciones, precisiones decimales , etc.//
	protected override void OnModelCreating(ModelBuilder modelBuilder)
	{
		base.OnModelCreating(modelBuilder);
		
		modelBuilder.Entity<MovimientoStock>()
		.HasKey(x=>x.MovimientoId);

		/*modelBuilder.Entity<Usuario>()
			.HasOne(x=>x.Rol)
			.WithMany(x=>x.Usuarios)
			.HasForeignKey(x=>x.RolId);*/
			
		modelBuilder.Entity<Usuario>()
			.HasOne(u => u.Rol)
			.WithMany(r => r.Usuarios)
			.HasForeignKey(u => u.RolId);

		modelBuilder.Entity<RolPermiso>()
		.HasKey(x=> new {
			x.RolId,
			x.PermisoId
		});
		
		modelBuilder.Entity<Permiso>()
			.HasIndex(p => p.Nombre)
			.IsUnique();

		modelBuilder.Entity<RolPermiso>()
			.HasOne(x=>x.Rol)
			.WithMany(x=>x.RolPermisos)
			.HasForeignKey(x=>x.RolId);

		modelBuilder.Entity<RolPermiso>()
			.HasOne(x=>x.Permiso)
			.WithMany(x=>x.RolPermisos)
			.HasForeignKey(x=>x.PermisoId);

	}
}