using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Microsoft.AspNetCore.Authorization;

//[Authorize(Roles = "Admin")]/*Suponiendo que solo el admin tiene acceso a productos*/
[Authorize]
[ApiController]
[Route("api/[controller]")]
public class ProductosController : ControllerBase
{
    private readonly AppDbContext _context;

    public ProductosController(AppDbContext context)
    {
        _context = context;
    }

	// GET: api/productos- leer prodcuto
    [HttpGet]
    [Authorize]
    public async Task<IActionResult> Get()
   {
        var productos = await _context.Productos.ToListAsync();
        return Ok(productos);
    }
	
	// Get {1}/api/productos
	[HttpGet("{id}")] /*Listar productos*/
	[Authorize]
	public async Task<IActionResult> GetById(int id)
	{
		var producto = await _context.Productos.FindAsync(id); //FindAsync(id) es la mejor opción cuando buscas por la clave primaria.

		if (producto == null)
			return NotFound();

		return Ok(producto);
	}
	
    // POST: api/productos
	[HttpPost]
	[Authorize]
    //[Authorize(Roles = "ADMIN")]
    public async Task<IActionResult> Post(Producto producto)
    {
        _context.Productos.Add(producto);
        await _context.SaveChangesAsync();
        return Ok(producto);
    }

    [HttpPut("{id}")]  /*Modificar productos*/
	[Authorize(Roles="ADMIN")]
    public async Task<IActionResult> Put(int id, [FromBody] Producto producto)
    {
        var p = await _context.Productos.FindAsync(id);
        if (p == null) return NotFound();

        //p.Codigo = producto.Codigo;
		p.Nombre = producto.Nombre;
		p.Descripcion = producto.Descripcion;
		//p.PrecioCompra = producto.PrecioCompra;
		p.PrecioVenta = producto.PrecioVenta;
		//p.Stock = producto.Stock;
		p.StockMinimo = producto.StockMinimo;
		p.ProveedorId = producto.ProveedorId;
		p.Activo = producto.Activo;

        await _context.SaveChangesAsync();
        return Ok(p);
    }

    [HttpDelete("{id}")]
	[Authorize(Roles="ADMIN")]
    public async Task<IActionResult> Delete(int id)
    {
        var p = await _context.Productos.FindAsync(id);
		
        if (p == null) return NotFound();

        _context.Productos.Remove(p);
        await _context.SaveChangesAsync();
        return Ok();
    }
}